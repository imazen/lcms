# lcms port — common recipes
#
# Gates:      test / gate / verify / testbed
# Benches:    bench / bench-one / c-oracle
# Coverage:   coverage / coverage-all / coverage-testbed
# API docs:   api-doc / api-doc-check
# Misc:       regen / fmt / check

## Gates ---------------------------------------------------------------------

# Run all gates (unit + C-parity tests)
test:
    cargo test --workspace

# Run one module's parity gate: `just gate pcs`
gate name:
    cargo test -p lcms --test c_parity_{{name}}

# Determinism gate: manifest under canonical math (C oracle resolves
# to the same libm-crate impls via symbol interposition -> C==R by
# construction, all cells) AND LCMS_CREF_MATH=sys (system-libm oracle
# for math-delta docs; XX confined to transcendental cells).
determinism-gate:
    bench/determinism-gate.sh

# Write per-platform cell hashes for the cross-platform compare job:
#   just determinism-goldens out/<triple>/
determinism-goldens dir:
    bench/determinism-gate.sh --goldens {{dir}}

# Full gate: cargo tests + upstream testbed + api-doc check + bench
# differentials — the whole port-conformance sweep.
verify: test determinism-gate testbed api-doc-check
    bench/bench.sh 2>&1 | grep -A10 "differentials"

# Build + run the upstream testbed (testcms2) against both libs in a scratch
# dir; reports the C and Rust pass counts.
testbed:
    bench/testbed.sh

## Benches --------------------------------------------------------------------

# Reproducible C-vs-Rust benchmarks — builds the C oracle (reference/lcms2,
# cc -O2 -fno-strict-aliasing) and liblcms2_ffi.so, links each bench/*.c
# against both, runs in the upstream testbed dir, prints MPix/s side by side.
bench:
    bench/bench.sh

# A subset: `just bench-one b32 diff_c8`
bench-one +names:
    bench/bench.sh {{names}}

# Build just the C oracle static lib (bench/out/liblcms2_c.a)
c-oracle:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p bench/out
    for f in ../reference/lcms2/src/*.c; do \
        cc -O2 -fno-strict-aliasing -I../reference/lcms2/include -c "$f" \
            -o "bench/out/$(basename "$f" .c).o"; \
    done
    ar rcs bench/out/liblcms2_c.a bench/out/*.o

## Coverage -------------------------------------------------------------------
#
# Two axes, because the numbers answer different questions:
#
#   `cargo test` coverage (`just coverage`) — the c_parity_* oracle gates.
#   Deeper on the pure-function/kernels (intrp ~91%) but reaches nothing that
#   only the testbed drives (formatters, profile builders).
#
#   testbed coverage (`just coverage-testbed`) — testcms2 against each lib,
#   instrumented. The honest port-comparison number: it covers the
#   formatter/transform-matrix/profile-builder surface the cargo suite can't
#   (it runs against liblcms2_ffi.so, not the rlib). Reports C oracle AND
#   Rust side by side — ~74%/83% vs ~67%/68% (lines/fns).

# Source-based coverage of the c_parity_* oracle suite (lcms crate).
coverage:
    cargo llvm-cov -p lcms --summary-only

# Full workspace incl. lcms2-ffi (0% under cargo test — it links via the .so
# through testcms2, not the rlib). Use coverage-testbed for the real number.
coverage-all:
    cargo llvm-cov --workspace --summary-only

# Testbed-driven coverage on BOTH sides — builds the C oracle + testcms2 and
# liblcms2_ffi.so each instrumented, runs testcms2 against both, and reports
# the llvm-cov line coverage each reaches. The honest port-coverage
# comparison (needs clang + llvm-cov-14 for the C side).
coverage-testbed:
    bench/coverage.sh

# C-oracle coverage through the PARITY SUITE — rebuilds lcms-cref with clang
# coverage instrumentation, runs every c_parity_* binary, unions the reports.
# Answers "which C paths have a gate" — complementary to coverage-testbed's
# "which C paths testcms2 reaches". Measurement only; the gcc oracle remains
# the parity contract (a few gates report ulp diffs under clang).
coverage-cref:
    bench/coverage-cref.sh

## API docs --------------------------------------------------------------------

# Regenerate the public-API surface snapshots (docs/public-api/).
api-doc:
    cargo test --manifest-path apidoc/Cargo.toml

# Verify the committed snapshots are current
api-doc-check:
    ZEN_API_DOC=check cargo test --manifest-path apidoc/Cargo.toml

## Misc ------------------------------------------------------------------------

# Regenerate tables/signatures after a submodule rebase
regen:
    python3 tools/gen_signatures.py > crates/lcms/src/signatures.rs
    python3 tools/gen_half_tables.py > crates/lcms/src/half_tables.rs

fmt:
    cargo fmt -p lcms -p lcms-cref

check:
    cargo check --workspace
